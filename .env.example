# ECHO backend configuration
ECHO_APP_ENV=production
ECHO_DSN=sqlite:/var/lib/echo/echo.sqlite

# Comma-separated extra browser origins. Leave empty for same-origin only.
ECHO_ALLOWED_ORIGINS=

# API limits
ECHO_CREATE_LIMIT=20
ECHO_REVEAL_LIMIT=60
ECHO_RATE_WINDOW_SECONDS=60
ECHO_MAX_CIPHERTEXT_CHARS=100000

# Enable only when ECHO is served exclusively over HTTPS.
ECHO_ENABLE_HSTS=false
