# ECHO backend configuration
ECHO_APP_ENV=production
ECHO_DSN=sqlite:/var/lib/echo/echo.sqlite

# Browser origins. Leave empty for same-origin only.
ECHO_ALLOWED_ORIGINS=

# Reverse proxies allowed to supply X-Forwarded-For/Proto/Host.
# Single-hop prototype deployments only. Examples: 127.0.0.1,10.0.0.0/8,2001:db8::/32
ECHO_TRUSTED_PROXIES=

# Secret used only to pseudonymize rate-limit identities with HMAC-SHA-256.
# Generate a unique value before exposing ECHO publicly: openssl rand -hex 32
ECHO_RATE_LIMIT_SECRET=change-me-with-at-least-32-random-bytes

# API limits
ECHO_CREATE_LIMIT=20
ECHO_REVEAL_LIMIT=60
ECHO_RATE_WINDOW_SECONDS=60
ECHO_MAX_CIPHERTEXT_CHARS=100000

# Enable only when the public origin is HTTPS (directly or through a trusted proxy).
ECHO_ENABLE_HSTS=false

# off | error | info. Logs never intentionally include message IDs, secrets, ciphertext, or raw IPs.
ECHO_LOG_LEVEL=info
